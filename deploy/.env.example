# Docker Compose settings for deploy/docker-compose.yml.
# Copy to deploy/.env (never commit the real file).

# Public URL of the site, no trailing slash. Used for API, media and SEO URLs.
#   local test : http://localhost:8080
#   production : https://exploreheroes.com
SITE_URL=http://localhost:8080

# Host port nginx listens on (80 in production behind no other proxy).
HTTP_PORT=8080

# Path to the Next.js repo, relative to this deploy/ folder (or absolute).
# VPS layout example: FRONTEND_PATH=/var/www/frontend
FRONTEND_PATH=../../explore-heros-travel-website

# MySQL
DB_DATABASE=explore_heroes
DB_USERNAME=explore_heroes
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Run `php artisan migrate --force` when the app container starts.
RUN_MIGRATIONS=true

# Optional: reuse an existing uploads folder instead of a named volume.
# UPLOADS_PATH=/var/www/backend/public/uploads

# true for local testing: the Next image optimizer can't reach
# http://localhost:8080 from inside its container. Keep false in production.
NEXT_IMAGE_UNOPTIMIZED=true

IMAGE_TAG=latest
