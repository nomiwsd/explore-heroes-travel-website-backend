# HTTPS for exploreheroes.com (SE-02).
#
# 1. Point the domain's A record at the server.
# 2. With the stack running on port 80, issue a certificate (webroot is
#    already served by default.conf at /.well-known/acme-challenge/):
#      docker run --rm -v "$PWD/certbot/www:/var/www/certbot" \
#        -v "$PWD/certbot/conf:/etc/letsencrypt" certbot/certbot certonly \
#        --webroot -w /var/www/certbot -d exploreheroes.com -d www.exploreheroes.com \
#        --email info@exploreheroes.com --agree-tos --no-eff-email
# 3. Copy this file to deploy/nginx-ssl.conf, mount it plus the certs in the
#    `web` service (see deploy/README.md), publish port 443, restart `web`.
# 4. Set SITE_URL=https://exploreheroes.com and APP_HTTPS=true, rebuild frontend.

# HTTP → HTTPS, and the bare IP / www → canonical domain
server {
    listen 80;
    server_name exploreheroes.com www.exploreheroes.com 72.62.254.34;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://exploreheroes.com$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name www.exploreheroes.com;
    ssl_certificate     /etc/letsencrypt/live/exploreheroes.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/exploreheroes.com/privkey.pem;
    return 301 https://exploreheroes.com$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name exploreheroes.com;

    ssl_certificate     /etc/letsencrypt/live/exploreheroes.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/exploreheroes.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    root /var/www/html/public;
    client_max_body_size 64m;
    large_client_header_buffers 4 32k;
    server_tokens off;

    set $php_upstream app:9000;
    set $next_upstream http://frontend:3000;

    location ~ ^/(api|admin/module|sanctum|broadcasting)(/|$) {
        fastcgi_pass $php_upstream;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTPS on;
        fastcgi_read_timeout 120s;
        fastcgi_buffers 16 32k;
        fastcgi_buffer_size 64k;
    }
    location ^~ /module/ { rewrite ^/module/(.*)$ /api/module/$1 last; }
    location ^~ /uploads/ { try_files $uri =404; expires 30d; access_log off; }
    location ^~ /storage/ { alias /var/www/html/storage/app/public/; try_files $uri =404; expires 30d; access_log off; }
    location ~ /\.(?!well-known) { deny all; }

    location / {
        proxy_pass $next_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}
